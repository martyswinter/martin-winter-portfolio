DirectoryIndex index.html

# 1. DOČASNÉ VYPNUTÍ PROXY CACHE PRO KONTROLU ZMĚN
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</IfModule>

RewriteEngine On
RewriteBase /

# 2. PŘESMĚROVÁNÍ Z WWW NA NON-WWW (POUZE PRO STRÁNKY, NE PRO CSS SOUBORY)
RewriteCond %{HTTP_HOST} ^www\.winter-ux\.eu$ [NC]
RewriteCond %{REQUEST_URI} !\.css$
RewriteRule ^(.*)$ https://winter-ux.eu [L,R=301]

# 3. ABSOLUTNÍ BARIÉRA PRO REALNÉ SOUBORY
# Pokud požadavek končí tečkou a příponou souboru, okamžitě ukonči zpracování a soubor vydej
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. SMĚROVÁNÍ PRO REACTION / SINGLE PAGE APLIKACI
# Pokud požadavek nemá příponu (je to virtuální URL), pošli jej na index.html
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5})$
RewriteRule ^ index.html [L]
